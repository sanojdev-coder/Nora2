# Azure OpenAI configuration for app.mcp.azure_openai_client.AzureOpenAIClient
# Copy this file to .env and replace the placeholder values before running locally.
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.services.ai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# ServiceNow configuration for app.mcp.servicenow_mcp_server.ServiceNowMCPServer
SERVICENOW_INSTANCE_URL=https://<your-instance>.service-now.com
SERVICENOW_CALLER_USERNAME=<your-caller-username>
SERVICENOW_USERNAME=<your-username>
SERVICENOW_PASSWORD=<your-password>
SERVICENOW_VERIFY_SSL=false
SERVICENOW_TIMEOUT_SECONDS=201
