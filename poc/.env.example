# Azure OpenAI configuration for app.mcp.azure_openai_client.AzureOpenAIClient
# Copy this file to .env and replace the placeholder values before running locally.
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.services.ai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
